<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.lemoyne.brakeindicator"
    android:versionCode="23"
    android:versionName="0.10.0">

    <uses-sdk
        android:minSdkVersion="19"
        android:targetSdkVersion="19" />

    <!-- Required on Gen5W so Activity.finish() does not throw SecurityException -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <!-- Allows non-touchable TYPE_SYSTEM_OVERLAY indicator on the top status bar row -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Used for 127.0.0.1:35000 loopback ELM327 fallback, ECDSA-signed OTA model updates, and HTTPS GitHub log uploads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Used for removable USB stick CSV dataset export, signed brake-model-*.jar import, & cloud-upload.json import -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Holo.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayService"
            android:exported="true" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="hmgapi.intent.action.STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
