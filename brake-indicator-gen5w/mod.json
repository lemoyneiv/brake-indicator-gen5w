{
  "id": "brake-indicator-gen5w",
  "name": "Brake Light Indicator",
  "version": "0.9.0",
  "hmgapi": ">=1.0.0",
  "authors": ["lemoyneiv"],
  "license": "AGPL-3.0",
  "repo": "https://github.com/lemoyneiv/brake-indicator-gen5w",
  "description": "Displays a non-intrusive brake light indicator icon on the top status bar row of Gen5W head units using E-GMP-calibrated HMG-API vehicle readings, automatic L0/L1/L2/L3/i-Pedal + Auto Regen, Smart Cruise Control (SCC) & Auto-Hold detection, modular ECDSA-signed OTA brake model updates over LTE/Wi-Fi, optional OBD-II ground-truth brake lamp telemetry via HMG-API's built-in BLE central (@hmgapi-ble + 127.0.0.1:35000 loopback bridge), and automatic compressed GitHub cloud log upload over LTE/Wi-Fi with removable USB fallback.",
  "live": true,
  "ble": {
    "central": true
  },
  "apps": [
    {
      "apk": "app/BrakeIndicator.apk",
      "package": "dev.lemoyne.brakeindicator"
    }
  ],
  "services": [
    {
      "name": "starter",
      "script": "svc/start.sh",
      "user": "system",
      "start": "android",
      "restart": false
    }
  ],
  "usb": ["BrakeIndicator"],
  "vehicle": {
    "read": [
      "brake.pressure",
      "speed",
      "pedal.accel",
      "gear.park",
      "parking_brake",
      "moving",
      "steering.angle",
      "hv.soc"
    ]
  },
  "provides": {
    "launcher": [
      {
        "title": "Brake Indicator",
        "package": "dev.lemoyne.brakeindicator",
        "class": ".MainActivity",
        "icon": "icons/icon.png",
        "icon_night": "icons/icon_night.png",
        "icon_disabled": "icons/icon_disabled.png",
        "icon_disabled_night": "icons/icon_disabled_night.png"
      }
    ],
    "star_key": [
      {
        "id": "open",
        "title": "Brake Indicator",
        "activity": {
          "package": "dev.lemoyne.brakeindicator",
          "class": ".MainActivity"
        }
      }
    ]
  }
}
